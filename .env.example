# Local API / mobile defaults
PORT=3000
DATABASE_URL=postgresql://rideagent:rideagent_local@localhost:5432/rideagent?schema=public
REDIS_URL=redis://localhost:6379
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
DEMO_MODE=true

# Optional Claude planner configuration. Leave the key as a placeholder for local demo mode.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=replace-with-anthropic-model-id

# Docker Compose local-only database credentials. Change them for a private environment.
POSTGRES_DB=rideagent
POSTGRES_USER=rideagent
POSTGRES_PASSWORD=rideagent_local
POSTGRES_PORT=5432
REDIS_PORT=6379

# ONDC/Beckn sandbox configuration. No live credentials are included.
# BECKN_* names take precedence in the adapter; ONDC_* aliases are also accepted.
BECKN_SANDBOX_URL=https://sandbox.example.invalid
BECKN_SUBSCRIBER_ID=replace-with-sandbox-subscriber-id
BECKN_SUBSCRIBER_URI=https://sandbox.example.invalid/beckn
BECKN_COUNTRY=IND
BECKN_CITY=std:011
BECKN_DOMAIN=ONDC:TRV11
BECKN_CORE_VERSION=1.2.0

ONDC_SANDBOX_URL=
ONDC_SUBSCRIBER_ID=
ONDC_SUBSCRIBER_URI=
ONDC_COUNTRY=IND
ONDC_CITY=std:011
ONDC_DOMAIN=ONDC:TRV11
ONDC_CORE_VERSION=1.2.0
